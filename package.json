{
  "name": "mermaid-workbench",
  "version": "0.1.0",
  "private": true,
  "description": "A local-first library and editor for Mermaid diagrams.",
  "repository": {
    "type": "git",
    "url": "https://github.com/finessevanes/mermaid-workbench.git"
  },
  "bugs": {
    "url": "https://github.com/finessevanes/mermaid-workbench/issues"
  },
  "homepage": "https://github.com/finessevanes/mermaid-workbench#readme",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently --kill-others --names api,web --prefix-colors blue,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "node --disable-warning=ExperimentalWarning --watch --import tsx src/server/main.ts",
    "dev:e2e": "concurrently --raw --kill-others \"npm:dev:api\" \"npm:dev:web\"",
    "dev:web": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "NODE_ENV=production node --disable-warning=ExperimentalWarning --import tsx src/server/main.ts",
    "test": "node --disable-warning=ExperimentalWarning ./node_modules/vitest/vitest.mjs run",
    "test:watch": "node --disable-warning=ExperimentalWarning ./node_modules/vitest/vitest.mjs",
    "test:e2e": "node --import tsx e2e/run-playwright.ts",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@dagrejs/dagre": "^3.0.0",
    "@xyflow/react": "^12.11.2",
    "mermaid": "^11.10.1",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "@vitejs/plugin-react": "^5.0.2",
    "concurrently": "^9.2.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2",
    "vite": "^7.1.3",
    "vitest": "^3.2.4"
  }
}
